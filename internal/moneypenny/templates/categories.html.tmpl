{{define "content"}}

<h2>Categories</h2>

<table>
  <thead>
	<tr>
	  <th>Name</th>
	  <th>Action</th>
	</tr>
  </thead>
  
  <tbody>
	{{range . }}
	<tr>
	  <td>{{.Name}}</td>
	  <td><button data-on:click="@delete('category/{{.Name}}')">Delete</button></td>
	</tr>
	{{end}}

	<tr>
	  <form method="POST">
		<td><input type="text" id="name" name="name"
				   required autofocus /></td>
		<td><button>Create</button> </td>
	  </form>
	</tr>
  </tbody>
</table>

{{end}}
