{{define "content"}}

<h2>Categories</h2>

<table>
  <thead>
	<tr>
	  <th>Name</th>
	  <th>Action</th>
	</tr>
  </thead>
  
  <tbody>
	{{range . }}
	<tr>
	  <td>{{.Name}}</td>
	  <td><a href="/category/{{.ID}}">Edit</a></td>
	</tr>
	{{end}}

	<tr>
	  <td><input type="text" /></td>
	  <td><a href="/category">Create</a></td>
	</tr>
  </tbody>
</table>

{{end}}
