{{define "content"}}

<h1>Login - Step 2</h1>

<p>
  A login link as been sent via E-mail to <cite>{{.}}</cite>.
  <strong>Please also check your spam folder.</strong>
</p>

<p>
  Enter the sent verification code to complete the login
  procedure.
</p>

<form method="POST" action="/auth/verify">
  <label for="code">Verification code:</label>
  <input type="text" name="code" id="code" required="true" />
  <input type="hidden" name="email" id="email" required="true"
		 value="{{.}}" />

  <a href="/" class="secondary">Cancel</a>
  <button class="primary">Login</button>
</form>

{{end}}
